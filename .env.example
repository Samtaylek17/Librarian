# Copy to `.env` and edit. `.env` is gitignored.
# `set -a; source .env; set +a` before launching the serving scripts or
# the matrix runner so these are exported into the environment.
#
# Nothing in this repo is hard-coded to a specific host or user; every
# site-specific value lives here.

# ── LLM serving endpoint ──────────────────────────────────────────────
# OpenAI-compatible chat-completions endpoint the agents talk to. vLLM
# accepts any key; "dummy" is the default the code falls back to.
OPENAI_API_KEY=dummy
# Endpoint used for single runs when you don't pass --base-url explicitly.
# (run_matrix.py injects per-worker URLs via --urls instead.)
# EVAL_BASE_URL=http://localhost:8000/v1

# ── vLLM serve  (scripts/serving/vllm_serve_energy.sh) ────────────────
# Paper backbones: Qwen/Qwen3.6-35B-A3B-FP8 and Qwen/Qwen3.6-27B-FP8.
VLLM_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
# Conda install base + env name that has vllm (and this package)
# installed. Leave CONDA_BASE unset to run from an already-active env.
# CONDA_BASE=$HOME/miniconda3
# VLLM_ENV=vllm
# Repo root (defaults to the git toplevel of the script if unset).
# REPO_ROOT=/path/to/efficient-multi-agent-swe

# ── Dense-retrieval RAG baseline only ─────────────────────────────────
# Needed solely to reproduce the `sfr_code` retrieval baseline; served by
# scripts/serving/sfr_embed_serve.sh. Point the YAML's
# `retrieval_endpoint` here.
# RETRIEVAL_ENDPOINT=http://localhost:9002

# ── analysis/ ─────────────────────────────────────────────────────────
# Colon-separated search path the raw-episode analyses use to resolve a
# matrix log dir. Defaults to <repo>/logs. Set it when archived
# main-results matrices live on another volume.
# EPISODE_LOG_PATH=/data/librarian_logs:./logs

# ── run_matrix.py ─────────────────────────────────────────────────────
# Interpreter used to spawn per-episode subprocesses (defaults to the
# current python).
# PYTHON=python
